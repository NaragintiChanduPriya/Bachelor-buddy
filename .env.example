# Base URL for all API calls. With mocking enabled this is intercepted by MSW.
VITE_API_BASE_URL=/api

# "enabled" starts Mock Service Worker before the app renders. "disabled" talks to a real backend.
VITE_API_MOCKING=enabled

# Fraction of mock API calls that fail randomly, to exercise error states. 0 disables.
VITE_MOCK_FAILURE_RATE=0.03

# "true" shows the TanStack Query Devtools launcher in development. Off by default.
VITE_QUERY_DEVTOOLS=false
